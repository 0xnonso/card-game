DSTACK_SIMULATOR_ENDPOINT=/tmp/tappd.sock

# HTTP server
PORT=3000

# Auth (JWT)
# Used by `@fastify/jwt` to verify bearer tokens for POST /shuffle.
JWT_SECRET=change-me

# Redis (queue + job store)
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=1
JOB_TTL_SECONDS=86400

# TEE-derived wallet label (used for the /tee_wallet endpoint and the optional on-chain callback)
TEE_WALLET_LABEL=tee_wallet

# TEE-backed shuffle RNG label prefix (per-job uniqueness comes from the jobId seedContext)
SHUFFLE_RNG_LABEL=shuffle-rng

# Optional: after proofs are generated, the worker can call
# TrustedShuffleService.storeInputProofs(...) from the TEE wallet.
CALL_TRUSTED_CONTRACT=false
# Only Sepolia (11155111) is supported right now.
SHUFFLE_RPC_URL=https://sepolia.gateway.tenderly.co
